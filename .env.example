# Настройки API-ключей для голосового помощника Спутник
# Скопируйте этот файл в .env и укажите ваши ключи

# Провайдер искусственного интеллекта: google или openai
AI_PROVIDER=google
AI_MODEL=gemini-flash-lite-latest

# Ключ Google AI Studio (Gemini) - бесплатно на https://aistudio.google.com/
GEMINI_API_KEY=ваш_ключ_здесь

# Ключ Serper.dev для поиска в интернете (Google Search API, бесплатно 2500 запросов на https://serper.dev/)
# При отсутствии ключа работает бесплатный поиск фактов через Википедию
SERPER_API_KEY=ваш_ключ_здесь

# Ключ OpenAI (опционально, если AI_PROVIDER=openai)
OPENAI_API_KEY=ваш_ключ_здесь
AI_BASE_URL=https://api.openai.com/v1

# Ключ OpenWeatherMap (опционально, при отсутствии ключа работает Open-Meteo)
OPENWEATHER_API_KEY=ваш_ключ_здесь

# Ключ Yandex SpeechKit (опционально, для синтеза голосом Кирилл)
YANDEX_API_KEY=ваш_ключ_здесь

